+AN_OXIDE_YIELD = {    # n/s/g, (alpha,n) on oxygen in the oxide (approximate)
+    "Pu238": 1.34e4, "Pu239": 3.81e1, "Pu240": 1.41e2,
+    "Pu241": 1.3,    "Pu242": 2.0,    "Am241": 2.69e3,
