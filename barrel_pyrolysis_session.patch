+    out = []
+    for p, ph in enumerate(phases):
+        k = 1 - p
+        po = phases[k]
+        Sa = ph.Sa_T(float(np.mean(T[p])), neutron_temperature(phases, T))
+        for g in range(N_GROUPS):
